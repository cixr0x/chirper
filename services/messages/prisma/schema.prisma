generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Conversation {
  id                      String    @id @db.VarChar(64)
  participantLowUserId    String    @map("participant_low_user_id") @db.VarChar(64)
  participantHighUserId   String    @map("participant_high_user_id") @db.VarChar(64)
  lastMessageId           String?   @map("last_message_id") @db.VarChar(64)
  lastMessagePreview      String    @default("") @map("last_message_preview") @db.VarChar(180)
  lastMessageAuthorUserId String?   @map("last_message_author_user_id") @db.VarChar(64)
  lastMessageAt           DateTime? @map("last_message_at")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  @@unique([participantLowUserId, participantHighUserId], map: "msg_conversations_participants_key")
  @@index([lastMessageAt, id], map: "msg_conversations_last_message_idx")
  @@map("msg_conversations")
}

model Message {
  id             String   @id @db.VarChar(64)
  conversationId String   @map("conversation_id") @db.VarChar(64)
  authorUserId   String   @map("author_user_id") @db.VarChar(64)
  body           String   @db.VarChar(2000)
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([conversationId, createdAt, id], map: "msg_messages_conversation_created_idx")
  @@map("msg_messages")
}

model ConversationRead {
  id                String    @id @db.VarChar(64)
  conversationId    String    @map("conversation_id") @db.VarChar(64)
  userId            String    @map("user_id") @db.VarChar(64)
  lastReadMessageId String?   @map("last_read_message_id") @db.VarChar(64)
  lastReadAt        DateTime? @map("last_read_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@unique([conversationId, userId], map: "msg_conversation_reads_conversation_user_key")
  @@map("msg_conversation_reads")
}
