FROM node:22-bookworm-slim AS base

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates openssl \
  && rm -rf /var/lib/apt/lists/*

FROM base AS build

ARG WORKSPACE_PACKAGE
ARG WORKSPACE_DIR
ARG ENABLE_PRISMA=false
ARG START_KIND=service

ENV WORKSPACE_PACKAGE=${WORKSPACE_PACKAGE}
ENV WORKSPACE_DIR=${WORKSPACE_DIR}
ENV ENABLE_PRISMA=${ENABLE_PRISMA}
ENV START_KIND=${START_KIND}

COPY package*.json ./
COPY tsconfig.base.json ./
COPY service-boundaries.json ./
COPY apps ./apps
COPY packages ./packages
COPY scripts ./scripts
COPY services ./services

RUN npm ci

RUN npm run build -w @chirper/common \
  && npm run build -w @chirper/contracts-events

RUN if [ "${ENABLE_PRISMA}" = "true" ]; then npm run prisma:generate -w "${WORKSPACE_PACKAGE}"; fi

RUN npm run build -w "${WORKSPACE_PACKAGE}"

FROM base AS service-runtime

ARG WORKSPACE_PACKAGE
ARG WORKSPACE_DIR
ARG START_KIND=service

ENV NODE_ENV=production
ENV WORKSPACE_PACKAGE=${WORKSPACE_PACKAGE}
ENV WORKSPACE_DIR=${WORKSPACE_DIR}
ENV START_KIND=${START_KIND}

COPY package*.json ./
COPY tsconfig.base.json ./
COPY service-boundaries.json ./
COPY apps ./apps
COPY packages ./packages
COPY scripts ./scripts
COPY services ./services

RUN npm ci --omit=dev --workspace "${WORKSPACE_PACKAGE}" --include-workspace-root=false \
  && npm cache clean --force

COPY --from=build /app/packages ./packages
COPY --from=build /app/services ./services

CMD ["sh", "-lc", "cd \"${WORKSPACE_DIR}\" && node dist/main.js"]

FROM base AS web-runtime

ARG WORKSPACE_DIR=apps/web
ARG START_KIND=web

ENV NODE_ENV=production
ENV WORKSPACE_DIR=${WORKSPACE_DIR}
ENV START_KIND=${START_KIND}

COPY --from=build /app/apps/web/.next/standalone ./
COPY --from=build /app/apps/web/.next/static ./apps/web/.next/static

CMD ["sh", "-lc", "node \"${WORKSPACE_DIR}/server.js\""]
